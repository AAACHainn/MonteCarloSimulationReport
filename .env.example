DATABASE_URL="file:./dev.db"
# Opt in only after backup and runtime validation; see docs/operations/sqlite-wal-validation.md.
SQLITE_DRIVER="native"
SQLITE_JOURNAL_MODE="delete"

# 32 random bytes, Base64 encoded. Keep this stable to decrypt saved Databento credentials.
MARKET_DATA_ENCRYPTION_KEY=""
# Service lifecycle scheduling works on any Node deployment. Set 0 to disable it.
MARKET_DATA_SYNC_ENABLED="1"

# AI credential encryption master key; generate once with node scripts/setup-ai-key.mjs.
AI_ENCRYPTION_KEY=""
