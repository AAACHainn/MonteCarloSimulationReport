generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum CompoundingMode {
  SIMPLE_FIXED_RISK
  COMPOUND
  STEP_COMPOUND
}

enum SamplingMethod {
  BOOTSTRAP_WITH_REPLACEMENT
}

enum TradeOptionType {
  INSTRUMENT
  STRATEGY
}

model TradeDataset {
  id             String          @id @default(cuid())
  name           String
  description    String?
  trades         Trade[]
  simulationRuns SimulationRun[]
  tradeJournal   TradeJournal?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Trade {
  id                 String       @id @default(cuid())
  datasetId          String
  dataset            TradeDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  date               DateTime?
  symbol             String?
  direction          String?
  pnl                Float?
  riskAmount         Float?
  rMultiple          Float
  note               String?
  instrumentOptionId String?
  instrumentOption   TradeOption? @relation("TradeInstrumentOption", fields: [instrumentOptionId], references: [id])
  strategyOptionId   String?
  strategyOption     TradeOption? @relation("TradeStrategyOption", fields: [strategyOptionId], references: [id])
  entryPrice         Float?
  stopLossPrice      Float?
  targetPrice        Float?
  exitPrice          Float?
  strategyCode       String?
  screenshotPath     String?
  tags               TradeTag[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([datasetId])
  @@index([instrumentOptionId])
  @@index([strategyOptionId])
}

model SimulationRun {
  id               String       @id @default(cuid())
  datasetId        String
  dataset          TradeDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  config           String
  summary          String
  samplePaths      String
  percentileCurves String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([datasetId])
  @@index([createdAt])
}

model TradeJournal {
  id          String       @id @default(cuid())
  name        String
  description String?
  datasetId   String       @unique
  dataset     TradeDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model TradeOption {
  id               String          @id @default(cuid())
  type             TradeOptionType
  name             String
  active           Boolean         @default(true)
  instrumentTrades Trade[]         @relation("TradeInstrumentOption")
  strategyTrades   Trade[]         @relation("TradeStrategyOption")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([type, name])
  @@index([type, active])
}

model TradeTag {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  trades         Trade[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name])
}

model MarketDataset {
  id           String               @id @default(cuid())
  name         String
  description  String?
  symbol       String
  timeframe    String
  timezone     String
  barCount     Int
  startTime    DateTime
  endTime      DateTime
  bars         MarketBar[]
  progress     ReplayProgress?
  paperSession PaperTradingSession?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([createdAt])
}

model MarketBar {
  datasetId String
  dataset   MarketDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  sequence  Int
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float?

  @@id([datasetId, sequence])
  @@unique([datasetId, timestamp])
}

model ReplayProgress {
  datasetId       String        @id
  dataset         MarketDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  startSequence   Int
  currentSequence Int
  intervalMs      Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model PaperTradingSession {
  id                    String             @id @default(cuid())
  datasetId             String             @unique
  dataset               MarketDataset      @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  initialCapital        Float
  currency              String
  commissionBps         Float              @default(0)
  slippageBps           Float              @default(0)
  lastProcessedSequence Int
  netQuantity           Float              @default(0)
  averageEntryPrice     Float?
  realizedPnl           Float              @default(0)
  totalFees             Float              @default(0)
  totalSlippage         Float              @default(0)
  peakEquity            Float
  maxDrawdown           Float              @default(0)
  version               Int                @default(1)
  orders                PaperOrder[]
  fills                 PaperFill[]
  trades                PaperTrade[]
  equityPoints          PaperEquityPoint[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([datasetId])
}

model PaperOrder {
  id                 String              @id @default(cuid())
  sessionId          String
  session            PaperTradingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  side               String
  type               String
  status             String              @default("PENDING")
  quantity           Float
  price              Float?
  stopLoss           Float?
  takeProfit         Float?
  reduceOnly         Boolean             @default(false)
  isProtective       Boolean             @default(false)
  ocoGroupId         String?
  createdSequence    Int
  activeFromSequence Int
  filledSequence     Int?
  filledAt           DateTime?
  filledPrice        Float?
  cancelReason       String?
  fills              PaperFill[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([sessionId, status])
  @@index([sessionId, createdSequence])
}

model PaperFill {
  id                String              @id @default(cuid())
  sessionId         String
  session           PaperTradingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  orderId           String
  order             PaperOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sequence          Int
  timestamp         DateTime
  side              String
  price             Float
  quantity          Float
  fee               Float
  slippageCost      Float
  realizedPnl       Float
  closedQuantity    Float
  openedQuantity    Float
  netQuantityAfter  Float
  averagePriceAfter Float?
  reason            String
  createdAt         DateTime            @default(now())

  @@index([sessionId, sequence])
  @@index([orderId])
}

model PaperTrade {
  id             String              @id @default(cuid())
  sessionId      String
  session        PaperTradingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  side           String
  status         String              @default("OPEN")
  openedSequence Int
  openedAt       DateTime
  closedSequence Int?
  closedAt       DateTime?
  grossPnl       Float               @default(0)
  fees           Float               @default(0)
  plannedRisk    Float?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([sessionId, status])
  @@index([sessionId, openedSequence])
}

model PaperEquityPoint {
  sessionId String
  session   PaperTradingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sequence  Int
  timestamp DateTime
  balance   Float
  equity    Float
  drawdown  Float

  @@id([sessionId, sequence])
}
