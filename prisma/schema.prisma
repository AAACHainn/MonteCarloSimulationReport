generator client {
  provider = "prisma-client-js"
}

model AiSetting {
  id        String   @id
  value     String
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

model AiConversation {
  id          String      @id @default(cuid())
  name        String
  activeRunId String?     @unique
  messages    AiMessage[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  runId          String?
  role           String
  status         String         @default("COMPLETED")
  content        String
  result         String?
  contextId      String?
  createdAt      DateTime       @default(now())
  @@index([conversationId, createdAt, id])
}

model AiContext {
  id        String   @id @default(cuid())
  value     String
  createdAt DateTime @default(now())
}

model AiAsset {
  id        String   @id
  mime      String
  bytes     Int
  contextId String?
  chartHash String?
  contentHash String?
  createdAt DateTime @default(now())
}

model AiRun {
  id             String   @id
  conversationId String
  contextId      String?
  task           String
  status         String   @default("QUEUED")
  snapshot       String
  checkpoint     String   @default("[]")
  calls          Int      @default(0)
  usage          String   @default("[]")
  error          String?
  heartbeatAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([conversationId, createdAt])
  @@index([status, heartbeatAt])
}

// Protocol evidence is retained independently of chat messages and reports.
model AiRunStep {
  id             String   @id @default(cuid())
  runId          String
  stepNo         Int
  phase          String
  status         String
  adapterVersion String
  requestHash    String
  payload        String   @default("{}")
  usage          String   @default("{\"input\":null,\"output\":null}")
  durationMs     Int      @default(0)
  createdAt      DateTime @default(now())
  @@unique([runId, stepNo])
}

model AiChartVariant {
  id        String   @id
  contextId String
  value     String
  createdAt DateTime @default(now())
  @@index([contextId])
}

model AiToolCall {
  id              String   @id @default(cuid())
  runId           String
  stepNo          Int
  toolCallId      String
  toolIndex       Int
  name            String
  contractVersion String
  arguments       String
  argumentsHash   String
  scopeHash       String
  status          String
  result          String   @default("{}")
  receipts        String   @default("[]")
  durationMs      Int      @default(0)
  errorCode       String?
  createdAt       DateTime @default(now())
  @@unique([runId, toolCallId])
  @@index([runId, stepNo, toolIndex])
}

model AiAnalysis {
  id              String   @id
  runId           String   @unique
  replaySessionId String
  projectionId    String
  contextId       String
  content         String
  result          String?
  createdAt       DateTime @default(now())
  @@index([replaySessionId, createdAt])
}

model AiReviewRevision {
  id              String   @id @default(cuid())
  replaySessionId String
  logicalKey      String
  projectionId    String
  content         String
  sourceRunId     String?
  createdAt       DateTime @default(now())
  @@index([replaySessionId, logicalKey, createdAt])
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum CompoundingMode {
  SIMPLE_FIXED_RISK
  COMPOUND
  STEP_COMPOUND
}

enum SamplingMethod {
  BOOTSTRAP_WITH_REPLACEMENT
}

enum TradeOptionType {
  INSTRUMENT
  STRATEGY
}

model TradeDataset {
  id             String          @id @default(cuid())
  name           String
  description    String?
  trades         Trade[]
  simulationRuns SimulationRun[]
  tradeJournal   TradeJournal?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Trade {
  id                 String       @id @default(cuid())
  datasetId          String
  dataset            TradeDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  date               DateTime?
  symbol             String?
  direction          String?
  pnl                Float?
  riskAmount         Float?
  rMultiple          Float
  note               String?
  instrumentOptionId String?
  instrumentOption   TradeOption? @relation("TradeInstrumentOption", fields: [instrumentOptionId], references: [id])
  strategyOptionId   String?
  strategyOption     TradeOption? @relation("TradeStrategyOption", fields: [strategyOptionId], references: [id])
  entryPrice         Float?
  stopLossPrice      Float?
  targetPrice        Float?
  exitPrice          Float?
  strategyCode       String?
  screenshotPath     String?
  tags               TradeTag[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([datasetId])
  @@index([instrumentOptionId])
  @@index([strategyOptionId])
}

model SimulationRun {
  id               String       @id @default(cuid())
  datasetId        String
  dataset          TradeDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  config           String
  summary          String
  samplePaths      String
  percentileCurves String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([datasetId])
  @@index([createdAt])
}

model TradeJournal {
  id          String       @id @default(cuid())
  name        String
  description String?
  datasetId   String       @unique
  dataset     TradeDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model TradeOption {
  id               String          @id @default(cuid())
  type             TradeOptionType
  name             String
  active           Boolean         @default(true)
  checklist        String          @default("[]")
  checklistVersion Int             @default(1)
  instrumentTrades Trade[]         @relation("TradeInstrumentOption")
  strategyTrades   Trade[]         @relation("TradeStrategyOption")
  replayJournalSetups ReplayJournalEntry[] @relation("ReplayJournalSetupOption")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([type, name])
  @@index([type, active])
}

model TradeTag {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  trades         Trade[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name])
}

model TradeReason {
  id                   String               @id @default(cuid())
  name                 String
  normalizedName       String               @unique
  replayJournalEntries ReplayJournalEntry[] @relation("ReplayJournalTradeReasons")
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([name])
}

model MarketDataset {
  id           String               @id @default(cuid())
  name         String
  description  String?
  symbol       String
  timeframe    String
  timezone     String
  status                String  @default("READY")
  dataVersion           Int     @default(1)
  historyVersion        Int     @default(1)
  replayGeneration      Int     @default(0)
  nextReplayJournalNo   Int     @default(0)
  activeAggregationId   String?
  sourceIntervalSeconds Int?
  barEmissionMode      String  @default("UNKNOWN")
  priceTickSize         Float   @default(0.01)
  sessionMode           String  @default("TWENTY_FOUR_SEVEN")
  sessionOpenMinute     Int?
  sessionCloseMinute    Int?
  tradingWeekdays       String  @default("1,2,3,4,5,6,7")
  barCount     Int
  startTime    DateTime
  endTime      DateTime
  bars         MarketBar[]
  aggregationGenerations MarketAggregationGeneration[]
  aggregationJobs MarketAggregationJob[]
  importJobs   MarketDatasetImport[]
  progress     ReplayProgress[]
  paperSession PaperTradingSession[]
  replaySessions ReplaySession[]
  replayJournalSessions ReplayJournalSession[]
  drawings     MarketDrawing[]
  syncConfig   MarketDatasetSyncConfig?
  syncRuns     MarketDataSyncRun[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([createdAt])
}

model MarketDataConnection {
  id            String   @id @default("databento")
  encryptedKey  String
  keySuffix     String
  keyVersion    Int      @default(1)
  status        String   @default("UNTESTED")
  testedAt      DateTime?
  error         String?
  updatedAt     DateTime @updatedAt
}

model MarketDatasetSyncConfig {
  datasetId       String   @id
  dataset         MarketDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  mode            String   @default("OFF")
  profile         String
  schedule        String
  perRunBudget    Float    @default(0)
  dailyBudget     Float    @default(0)
  checkedThrough  DateTime?
  verified        Boolean  @default(false)
  nextRunAt       DateTime?
  lastCheckedAt   DateTime?
  availableThrough DateTime?
  pausedReason    String?
  leaseOwner      String?
  leaseUntil      DateTime?
  updatedAt       DateTime @updatedAt
  @@index([mode, nextRunAt])
}

model MarketDataSyncRun {
  id              String   @id @default(cuid())
  datasetId       String
  dataset         MarketDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  trigger         String
  status          String   @default("QUEUED")
  stage           String   @default("CHECKING")
  configSnapshot  String
  requestStart    DateTime?
  requestEnd      DateTime?
  cursor          DateTime?
  addedBars       Int      @default(0)
  estimatedCost   Float    @default(0)
  charges         String   @default("[]")
  mappings        String   @default("{}")
  conflicts       String   @default("[]")
  error           String?
  leaseOwner      String?
  leaseUntil      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([status, createdAt])
  @@index([datasetId, createdAt])
  @@index([datasetId, updatedAt])
}

model MarketDatasetUpdateLease {
  datasetId String @id
  owner     String
  expiresAt DateTime
}

model MarketSyncSchedulerLease {
  id        String @id
  owner     String
  expiresAt DateTime
  heartbeat DateTime
}

model MarketDrawing {
  id        String        @id @default(cuid())
  datasetId String
  dataset   MarketDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  replaySessionId String?
  replaySession ReplaySession? @relation(fields: [replaySessionId], references: [id], onDelete: Cascade)
  type      String
  geometry  String
  style     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([datasetId, createdAt])
  @@index([replaySessionId, createdAt])
}

model MarketAggregationGeneration {
  id String @id @default(cuid())
  datasetId String
  dataset MarketDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  ruleVersion Int
  historyVersion Int
  fingerprint String
  cursor Int @default(-1)
  tailState String @default("{}")
  status String @default("BUILDING")
  bars MarketAggregatedBar[]
  jobs MarketAggregationJob[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([datasetId, createdAt])
}

model MarketAggregatedBar {
  generationId String
  generation MarketAggregationGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  scope String
  intervalSeconds Int
  bucketStart DateTime
  bucketEnd DateTime
  firstSequence Int
  lastSequence Int
  firstTime DateTime
  lastTime DateTime
  open Float
  high Float
  low Float
  close Float
  volume Float?
  volumeCount Int
  sourceCount Int
  expectedCount Int
  @@id([generationId, scope, intervalSeconds, bucketStart])
}

model MarketAggregationJob {
  id String @id @default(cuid())
  datasetId String
  dataset MarketDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  activeDatasetId String? @unique
  generationId String?
  generation MarketAggregationGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)
  status String @default("QUEUED")
  targetSequence Int
  cursor Int @default(-1)
  cancelRequested Boolean @default(false)
  workerToken String?
  leaseUntil DateTime?
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([datasetId, createdAt])
}

model MarketDatasetImport {
  id                 String        @id @default(cuid())
  datasetId          String?
  dataset            MarketDataset? @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  status             String        @default("CREATED")
  fileName           String
  storedPath         String?
  compressedBytes    BigInt        @default(0)
  expandedBytes      BigInt        @default(0)
  processedRows      Int           @default(0)
  importedBars       Int           @default(0)
  stage              String        @default("WAITING_UPLOAD")
  stageProcessedBytes BigInt       @default(0)
  stageTotalBytes    BigInt        @default(0)
  totalRows          Int           @default(0)
  stageStartedAt     DateTime?
  workerPid          Int?
  workerRssBytes     BigInt        @default(0)
  peakWorkerRssBytes BigInt        @default(0)
  totalErrors        Int           @default(0)
  errors             String        @default("[]")
  metadata           String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status, createdAt])
}

model MarketBar {
  datasetId String
  dataset   MarketDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  sequence  Int
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float?

  @@id([datasetId, sequence])
  @@unique([datasetId, timestamp])
}

model ReplayProgress {
  id              String        @id @default(cuid())
  datasetId       String
  dataset         MarketDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  replaySessionId String?       @unique
  replaySession ReplaySession? @relation(fields: [replaySessionId], references: [id], onDelete: Cascade)
  startSequence   Int
  currentSequence Int
  playbackRate    Int           @default(1)
  displayIntervalSeconds Int?
  displaySession         String        @default("ETH")
  generation            Int           @default(1)
  syncVersion           Int           @default(0)
  lastSyncRequestId     String?
  lastSyncResponse      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([datasetId])
}

model PaperTradingSession {
  id                    String             @id @default(cuid())
  datasetId             String
  dataset               MarketDataset      @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  projectionId          String?             @unique
  projection            ReplayProjection?   @relation(fields: [projectionId], references: [id], onDelete: Cascade)
  journalSessionId      String?
  journalSession        ReplayJournalSession? @relation(fields: [journalSessionId], references: [id], onDelete: SetNull)
  initialCapital        Float
  currency              String
  commissionBps         Float              @default(0)
  slippageBps           Float              @default(0)
  lastProcessedSequence Int
  netQuantity           Float              @default(0)
  activeCycleKey        String?
  averageEntryPrice     Float?
  realizedPnl           Float              @default(0)
  totalFees             Float              @default(0)
  totalSlippage         Float              @default(0)
  peakEquity            Float
  maxDrawdown           Float              @default(0)
  version               Int                @default(1)
  equitySampleStride    Int                @default(1)
  tradeStatsVersion     Int                @default(1)
  closedTradeCount      Int                @default(0)
  winningTradeCount     Int                @default(0)
  losingTradeCount      Int                @default(0)
  grossWinningPnl       Float              @default(0)
  grossLosingPnl        Float              @default(0)
  currentWinStreak      Int                @default(0)
  currentLossStreak     Int                @default(0)
  maxConsecutiveWins    Int                @default(0)
  maxConsecutiveLosses  Int                @default(0)
  orders                PaperOrder[]
  fills                 PaperFill[]
  trades                PaperTrade[]
  positionLots          PaperPositionLot[]
  equityPoints          PaperEquityPoint[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([datasetId])
}

model ReplayJournalSession {
  id             String               @id @default(cuid())
  datasetId      String
  dataset        MarketDataset        @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  replaySessionId String?              @unique
  replaySession ReplaySession?        @relation(fields: [replaySessionId], references: [id], onDelete: Cascade)
  name           String               @default("回放会话")
  replayGeneration Int
  initialCapital Float
  currency       String
  commissionBps  Float
  slippageBps    Float
  nextEntryNo    Int                  @default(0)
  archivedAt     DateTime?
  paperSession   PaperTradingSession[]
  entries        ReplayJournalEntry[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([datasetId, createdAt])
  @@index([datasetId, archivedAt])
}

model PaperPositionLot {
  id                       String              @id
  sessionId                String
  session                  PaperTradingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  entryFillId              String
  side                     String
  openedSequence           Int
  openedAt                 DateTime
  entryPrice               Float
  entryOrderType           String?
  initialStopPrice         Float?
  initialQuantity          Float
  remainingQuantity        Float
  initialRisk              Float?
  actualRisk               Float               @default(0)
  abrValue                 Float?
  abrLength                Int
  displayIntervalSeconds   Int
  displaySession           String
  displayUtcOffsetMinutes  Int
  priceTickSize            Float
  entryNetPnl              Float?
  discipline               String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@index([sessionId, openedSequence])
}

model ReplayReviewTemplate {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name])
}

model ReplayJournalEntry {
  id                       String               @id
  journalSessionId         String
  journalSession           ReplayJournalSession @relation(fields: [journalSessionId], references: [id], onDelete: Cascade)
  projectionId             String?
  projection               ReplayProjection? @relation(fields: [projectionId], references: [id], onDelete: Cascade)
  logicalKey               String?
  cycleKey                 String?
  no                       Int
  accountNo                Int                  @default(0)
  lotId                    String
  direction                String
  quantity                 Float
  openedSequence           Int
  openedAt                 DateTime
  closedSequence           Int
  closedAt                 DateTime
  entryPrice               Float
  entryOrderType           String?
  exitPrice                Float
  initialStopPrice         Float?
  abrValue                 Float?
  abrLength                Int
  displayIntervalSeconds   Int
  displaySession           String
  displayUtcOffsetMinutes  Int
  priceTickSize            Float
  initialRisk              Float
  actualRisk               Float
  gainLoss                 Float
  review                   String               @default("")
  setupOptionId            String?
  setupOption              TradeOption?         @relation("ReplayJournalSetupOption", fields: [setupOptionId], references: [id])
  tradeReasons             TradeReason[]         @relation("ReplayJournalTradeReasons")
  discipline               String?
  createdAt                DateTime             @default(now())

  @@unique([journalSessionId, id])
  @@unique([journalSessionId, projectionId, accountNo])
  @@index([projectionId, closedSequence])
  @@index([projectionId, cycleKey])
  @@index([journalSessionId, no])
  @@index([journalSessionId, openedSequence])
  @@index([journalSessionId, closedSequence])
  @@index([setupOptionId])
}

// A replay session keeps one current result and a temporary correction draft.
// Confirmation replaces the current result; cancellation discards the draft.
model ReplaySession {
  id                 String @id @default(cuid())
  datasetId          String
  dataset            MarketDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  name               String
  mode               String @default("TRAINING")
  status             String @default("ACTIVE")
  version            Int @default(1)
  activeProjectionId String? @unique
  activeProjection   ReplayProjection? @relation("ActiveReplayProjection", fields: [activeProjectionId], references: [id], onDelete: SetNull)
  pendingCorrectionId String?
  legacy             Boolean @default(false)
  riskPreferences    String @default("{}")
  trainingGate       String @default("{}")
  accountCategory    String @default("STANDARD")
  userId             String?
  user               UserProfile? @relation(fields: [userId], references: [id], onDelete: Restrict)
  growthEligible     Boolean @default(false)
  propAccount        PropPracticeAccount?
  progress           ReplayProgress?
  journal            ReplayJournalSession?
  projections        ReplayProjection[] @relation("SessionProjections")
  commands           ReplayCommand[]
  corrections        ReplayCorrectionJob[]
  drawings           MarketDrawing[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([datasetId, status, createdAt])
  @@index([userId, createdAt])
}

model UserProfile {
  id String @id @default(cuid())
  nickname String @unique
  avatar String @default("DEFAULT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions ReplaySession[]
  growth UserGrowth?
  facts UserGrowthFact[]
  breakthroughs UserRealmRecord[]
  wallet UserWallet?
  walletEntries UserWalletEntry[]
  walletAllocations UserWalletAllocation[]
}

model UserWallet {
  userId String @id
  user UserProfile @relation(fields: [userId], references: [id], onDelete: Restrict)
  balanceMinor BigInt @default(1000000)
  version Int @default(1)
  updatedAt DateTime @updatedAt
}

// Independent evidence: session/projection identifiers intentionally have no cascading relation.
model UserWalletEntry {
  id String @id @default(cuid())
  userId String
  user UserProfile @relation(fields: [userId], references: [id], onDelete: Restrict)
  sourceKey String @unique
  type String
  amountMinor BigInt
  balanceAfterMinor BigInt
  sessionId String?
  sessionName String @default("")
  roundNumber Int?
  createdAt DateTime @default(now())
  @@index([userId, createdAt, id])
}

model UserWalletAllocation {
  projectionId String @id
  userId String
  user UserProfile @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessionId String
  sessionName String
  depositedMinor BigInt
  withdrawnMinor BigInt @default(0)
  settledAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, settledAt, createdAt])
  @@index([sessionId])
}

// Projection only. Rebuilt from settled deltas, never from surviving sessions.
model UserGrowth {
  userId String @id
  user UserProfile @relation(fields: [userId], references: [id], onDelete: Restrict)
  totalXp Int @default(0)
  completedCycles Int @default(0)
  completedReviews Int @default(0)
  passedEvaluations Int @default(0)
  successfulPayouts Int @default(0)
  receivedUsdtMinor BigInt @default(0)
  realm String @default("MORTAL")
  layer Int @default(0)
  version Int @default(1)
  updatedAt DateTime @updatedAt
}

// Source identifiers are plain strings: deleting source data cannot delete evidence.
model UserGrowthFact {
  id String @id @default(cuid())
  userId String
  user UserProfile @relation(fields: [userId], references: [id], onDelete: Restrict)
  type String
  sourceKey String @unique
  firstPayoutKey String? @unique
  sessionId String
  roundNumber Int?
  sourceSummary String
  occurredAt DateTime
  settledAt DateTime @default(now())
  xpDelta Int @default(0)
  cyclesDelta Int @default(0)
  reviewsDelta Int @default(0)
  evaluationsDelta Int @default(0)
  payoutsDelta Int @default(0)
  receivedUsdtMinorDelta BigInt @default(0)
  ruleVersion String
  @@index([userId, settledAt, id])
}

model UserRealmRecord {
  id String @id @default(cuid())
  userId String
  user UserProfile @relation(fields: [userId], references: [id], onDelete: Restrict)
  fromRealm String
  toRealm String
  metricsSnapshot String
  ruleVersion String
  idempotencyKey String @unique
  attainedAt DateTime @default(now())
  @@unique([userId, toRealm])
}

model PropPracticeTemplate {
  id String @id @default(cuid())
  active Boolean @default(true)
  version Int @default(1)
  versions PropPracticeTemplateVersion[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PropPracticeTemplateVersion {
  id String @id @default(cuid())
  templateId String
  template PropPracticeTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  version Int
  rules String
  accounts PropPracticeAccount[]
  createdAt DateTime @default(now())
  @@unique([templateId, version])
}

model PropPracticeAccount {
  replaySessionId String @id
  replaySession ReplaySession @relation(fields: [replaySessionId], references: [id], onDelete: Cascade)
  templateVersionId String
  templateVersion PropPracticeTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  snapshot String
  state String
  roundNumber Int @default(1)
  rounds PropPracticeRound[]
  payouts PropPracticePayout[]
  events PropPracticeEvent[]
}

model PropPracticePayout {
  id String @id @default(cuid())
  replaySessionId String
  account PropPracticeAccount @relation(fields: [replaySessionId], references: [replaySessionId], onDelete: Cascade)
  requestId String
  roundNumber Int @default(1)
  amount Float
  received Float
  share Float
  evidence String
  createdAt DateTime @default(now())
  @@unique([replaySessionId, requestId])
}

model PropPracticeEvent {
  id String @id @default(cuid())
  replaySessionId String
  account PropPracticeAccount @relation(fields: [replaySessionId], references: [replaySessionId], onDelete: Cascade)
  type String
  roundNumber Int @default(1)
  evidence String
  createdAt DateTime @default(now())
  @@index([replaySessionId, createdAt])
}

model ReplayProjection {
  id              String @id @default(cuid())
  replaySessionId String
  replaySession   ReplaySession @relation("SessionProjections", fields: [replaySessionId], references: [id], onDelete: Cascade)
  activeFor       ReplaySession? @relation("ActiveReplayProjection")
  status          String @default("BUILDING")
  historyVersion  Int
  currentSequence Int
  account         PaperTradingSession?
  propRound       PropPracticeRound?
  entries         ReplayJournalEntry[]
  commands        ReplayProjectionCommand[]
  contexts        ReplayContextRun[]
  checkpoints     ReplayCheckpoint[]
  createdAt       DateTime @default(now())

  @@unique([replaySessionId, status])
}

// A business attempt, distinct from correction result versions. Only one round is current.
model PropPracticeRound {
  id String @id @default(cuid())
  replaySessionId String
  account PropPracticeAccount @relation(fields: [replaySessionId], references: [replaySessionId], onDelete: Cascade)
  number Int
  projectionId String @unique
  projection ReplayProjection @relation(fields: [projectionId], references: [id], onDelete: Cascade)
  snapshot String
  state String
  trainingGate String @default("{}")
  startSequence Int
  endSequence Int?
  resetRequestId String?
  createdAt DateTime @default(now())
  endedAt DateTime?
  @@unique([replaySessionId, number])
  @@unique([replaySessionId, resetRequestId])
}

model ReplayCommand {
  id              String @id @default(cuid())
  replaySessionId String
  replaySession   ReplaySession @relation(fields: [replaySessionId], references: [id], onDelete: Cascade)
  sourceSequence  Int
  ordinal         Int
  type            String
  payload         String
  projections     ReplayProjectionCommand[]
  createdAt       DateTime @default(now())

  @@index([replaySessionId, sourceSequence, ordinal])
}

model ReplayProjectionCommand {
  projectionId String
  projection ReplayProjection @relation(fields: [projectionId], references: [id], onDelete: Cascade)
  commandId String
  command ReplayCommand @relation(fields: [commandId], references: [id], onDelete: Cascade)

  @@id([projectionId, commandId])
  @@index([commandId])
}

model ReplayContextRun {
  id String @id @default(cuid())
  projectionId String
  projection ReplayProjection @relation(fields: [projectionId], references: [id], onDelete: Cascade)
  fromSequence Int
  toSequence Int
  context String

  @@index([projectionId, fromSequence, toSequence])
}

model ReplayCheckpoint {
  id String @id @default(cuid())
  projectionId String
  projection ReplayProjection @relation(fields: [projectionId], references: [id], onDelete: Cascade)
  sourceSequence Int
  commandOrdinal Int @default(0)
  state String
  createdAt DateTime @default(now())

  @@index([projectionId, sourceSequence, commandOrdinal])
}

model ReplayCorrectionJob {
  id String @id @default(cuid())
  requestId String?
  replaySessionId String
  replaySession ReplaySession @relation(fields: [replaySessionId], references: [id], onDelete: Cascade)
  type String
  status String @default("QUEUED")
  baseProjectionId String
  targetProjectionId String?
  targetSequence Int
  cycleKey String?
  expectedVersion Int
  historyVersion Int
  processedSourceBars Int @default(0)
  totalSourceBars Int @default(0)
  summary String @default("{}")
  error String?
  workerPid Int?
  heartbeatAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([replaySessionId, createdAt])
  @@index([status, heartbeatAt])
  @@unique([replaySessionId, requestId])
}

model PaperOrder {
  id                 String              @id @default(cuid())
  sessionId          String
  session            PaperTradingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  side               String
  type               String
  status             String              @default("PENDING")
  quantity           Float
  riskAmount         Float?
  price              Float?
  stopLoss           Float?
  takeProfit         Float?
  reduceOnly         Boolean             @default(false)
  isProtective       Boolean             @default(false)
  ocoGroupId         String?
  parentOrderId      String?
  createdSequence    Int
  activeFromSequence Int
  filledSequence     Int?
  filledAt           DateTime?
  filledPrice        Float?
  cancelReason       String?
  fills              PaperFill[]
  discipline               String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([sessionId, status])
  @@index([sessionId, createdSequence])
}

model PaperFill {
  id                String              @id @default(cuid())
  cycleKey          String?
  sessionId         String
  session           PaperTradingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  orderId           String
  order             PaperOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sequence          Int
  timestamp         DateTime
  side              String
  price             Float
  quantity          Float
  fee               Float
  slippageCost      Float
  realizedPnl       Float
  closedQuantity    Float
  openedQuantity    Float
  netQuantityAfter  Float
  averagePriceAfter Float?
  reason            String
  createdAt         DateTime            @default(now())

  @@index([sessionId, sequence])
  @@index([sessionId, cycleKey])
  @@index([orderId])
}

model PaperTrade {
  id             String              @id @default(cuid())
  sessionId      String
  session        PaperTradingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  side           String
  status         String              @default("OPEN")
  openedSequence Int
  openedAt       DateTime
  closedSequence Int?
  closedAt       DateTime?
  grossPnl       Float               @default(0)
  fees           Float               @default(0)
  plannedRisk    Float?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([sessionId, status])
  @@index([sessionId, openedSequence])
}

model PaperEquityPoint {
  sessionId String
  session   PaperTradingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sequence  Int
  timestamp DateTime
  balance   Float
  equity    Float
  drawdown  Float

  @@id([sessionId, sequence])
}
