generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum CompoundingMode {
  SIMPLE_FIXED_RISK
  COMPOUND
  STEP_COMPOUND
}

enum SamplingMethod {
  BOOTSTRAP_WITH_REPLACEMENT
}

enum TradeOptionType {
  INSTRUMENT
  STRATEGY
}

model TradeDataset {
  id             String          @id @default(cuid())
  name           String
  description    String?
  trades         Trade[]
  simulationRuns SimulationRun[]
  tradeJournal   TradeJournal?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Trade {
  id                 String       @id @default(cuid())
  datasetId          String
  dataset            TradeDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  date               DateTime?
  symbol             String?
  direction          String?
  pnl                Float?
  riskAmount         Float?
  rMultiple          Float
  note               String?
  instrumentOptionId String?
  instrumentOption   TradeOption? @relation("TradeInstrumentOption", fields: [instrumentOptionId], references: [id])
  strategyOptionId   String?
  strategyOption     TradeOption? @relation("TradeStrategyOption", fields: [strategyOptionId], references: [id])
  entryPrice         Float?
  stopLossPrice      Float?
  targetPrice        Float?
  exitPrice          Float?
  strategyCode       String?
  screenshotPath     String?
  tags               TradeTag[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([datasetId])
  @@index([instrumentOptionId])
  @@index([strategyOptionId])
}

model SimulationRun {
  id               String       @id @default(cuid())
  datasetId        String
  dataset          TradeDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  config           String
  summary          String
  samplePaths      String
  percentileCurves String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([datasetId])
  @@index([createdAt])
}

model TradeJournal {
  id          String       @id @default(cuid())
  name        String
  description String?
  datasetId   String       @unique
  dataset     TradeDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model TradeOption {
  id               String          @id @default(cuid())
  type             TradeOptionType
  name             String
  active           Boolean         @default(true)
  instrumentTrades Trade[]         @relation("TradeInstrumentOption")
  strategyTrades   Trade[]         @relation("TradeStrategyOption")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([type, name])
  @@index([type, active])
}

model TradeTag {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  trades         Trade[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name])
}

model MarketDataset {
  id           String               @id @default(cuid())
  name         String
  description  String?
  symbol       String
  timeframe    String
  timezone     String
  status                String  @default("READY")
  dataVersion           Int     @default(1)
  replayGeneration      Int     @default(0)
  nextReplayJournalNo   Int     @default(0)
  barBlockBuildCursor   Int     @default(-1)
  sourceIntervalSeconds Int?
  priceTickSize         Float   @default(0.01)
  sessionMode           String  @default("TWENTY_FOUR_SEVEN")
  sessionOpenMinute     Int?
  sessionCloseMinute    Int?
  tradingWeekdays       String  @default("1,2,3,4,5,6,7")
  barCount     Int
  startTime    DateTime
  endTime      DateTime
  bars         MarketBar[]
  barBlocks    MarketBarBlock[]
  importJobs   MarketDatasetImport[]
  progress     ReplayProgress?
  paperSession PaperTradingSession?
  replayJournalSessions ReplayJournalSession[]
  drawings     MarketDrawing[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([createdAt])
}

model MarketDrawing {
  id        String        @id @default(cuid())
  datasetId String
  dataset   MarketDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  type      String
  geometry  String
  style     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([datasetId, createdAt])
}

model MarketBarBlock {
  datasetId    String
  dataset      MarketDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  startSequence Int
  endSequence   Int
  startTime     DateTime
  endTime       DateTime
  open           Float
  high           Float
  low            Float
  close          Float
  volume         Float?
  volumeCount    Int
  barCount       Int

  @@id([datasetId, startSequence])
  @@index([datasetId, startTime, endTime])
}

model MarketDatasetImport {
  id                 String        @id @default(cuid())
  datasetId          String?
  dataset            MarketDataset? @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  status             String        @default("CREATED")
  fileName           String
  storedPath         String?
  compressedBytes    BigInt        @default(0)
  expandedBytes      BigInt        @default(0)
  processedRows      Int           @default(0)
  importedBars       Int           @default(0)
  stage              String        @default("WAITING_UPLOAD")
  stageProcessedBytes BigInt       @default(0)
  stageTotalBytes    BigInt        @default(0)
  totalRows          Int           @default(0)
  stageStartedAt     DateTime?
  workerPid          Int?
  workerRssBytes     BigInt        @default(0)
  peakWorkerRssBytes BigInt        @default(0)
  totalErrors        Int           @default(0)
  errors             String        @default("[]")
  metadata           String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status, createdAt])
}

model MarketBar {
  datasetId String
  dataset   MarketDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  sequence  Int
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float?

  @@id([datasetId, sequence])
  @@unique([datasetId, timestamp])
}

model ReplayProgress {
  datasetId       String        @id
  dataset         MarketDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  startSequence   Int
  currentSequence Int
  playbackRate    Int           @default(1)
  displayIntervalSeconds Int?
  displaySession         String        @default("ETH")
  generation            Int           @default(1)
  syncVersion           Int           @default(0)
  lastSyncRequestId     String?
  lastSyncResponse      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model PaperTradingSession {
  id                    String             @id @default(cuid())
  datasetId             String             @unique
  dataset               MarketDataset      @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  journalSessionId      String?             @unique
  journalSession        ReplayJournalSession? @relation(fields: [journalSessionId], references: [id], onDelete: SetNull)
  initialCapital        Float
  currency              String
  commissionBps         Float              @default(0)
  slippageBps           Float              @default(0)
  lastProcessedSequence Int
  netQuantity           Float              @default(0)
  averageEntryPrice     Float?
  realizedPnl           Float              @default(0)
  totalFees             Float              @default(0)
  totalSlippage         Float              @default(0)
  peakEquity            Float
  maxDrawdown           Float              @default(0)
  version               Int                @default(1)
  equitySampleStride    Int                @default(1)
  tradeStatsVersion     Int                @default(1)
  closedTradeCount      Int                @default(0)
  winningTradeCount     Int                @default(0)
  losingTradeCount      Int                @default(0)
  grossWinningPnl       Float              @default(0)
  grossLosingPnl        Float              @default(0)
  currentWinStreak      Int                @default(0)
  currentLossStreak     Int                @default(0)
  maxConsecutiveWins    Int                @default(0)
  maxConsecutiveLosses  Int                @default(0)
  orders                PaperOrder[]
  fills                 PaperFill[]
  trades                PaperTrade[]
  positionLots          PaperPositionLot[]
  equityPoints          PaperEquityPoint[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([datasetId])
}

model ReplayJournalSession {
  id             String               @id @default(cuid())
  datasetId      String
  dataset        MarketDataset        @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  replayGeneration Int
  initialCapital Float
  currency       String
  commissionBps  Float
  slippageBps    Float
  nextEntryNo    Int                  @default(0)
  archivedAt     DateTime?
  paperSession   PaperTradingSession?
  entries        ReplayJournalEntry[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([datasetId, createdAt])
  @@index([datasetId, archivedAt])
}

model PaperPositionLot {
  id                       String              @id
  sessionId                String
  session                  PaperTradingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  entryFillId              String
  side                     String
  openedSequence           Int
  openedAt                 DateTime
  entryPrice               Float
  entryOrderType           String?
  initialStopPrice         Float?
  initialQuantity          Float
  remainingQuantity        Float
  initialRisk              Float?
  actualRisk               Float               @default(0)
  abrValue                 Float?
  abrLength                Int
  displayIntervalSeconds   Int
  displaySession           String
  displayUtcOffsetMinutes  Int
  priceTickSize            Float
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@index([sessionId, openedSequence])
}

model ReplayJournalEntry {
  id                       String               @id
  journalSessionId         String
  journalSession           ReplayJournalSession @relation(fields: [journalSessionId], references: [id], onDelete: Cascade)
  no                       Int
  accountNo                Int                  @default(0)
  lotId                    String
  direction                String
  quantity                 Float
  openedSequence           Int
  openedAt                 DateTime
  closedSequence           Int
  closedAt                 DateTime
  entryPrice               Float
  entryOrderType           String?
  exitPrice                Float
  initialStopPrice         Float?
  abrValue                 Float?
  abrLength                Int
  displayIntervalSeconds   Int
  displaySession           String
  displayUtcOffsetMinutes  Int
  priceTickSize            Float
  initialRisk              Float
  actualRisk               Float
  gainLoss                 Float
  createdAt                DateTime             @default(now())

  @@unique([journalSessionId, id])
  @@unique([journalSessionId, accountNo])
  @@index([journalSessionId, no])
  @@index([journalSessionId, openedSequence])
  @@index([journalSessionId, closedSequence])
}

model PaperOrder {
  id                 String              @id @default(cuid())
  sessionId          String
  session            PaperTradingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  side               String
  type               String
  status             String              @default("PENDING")
  quantity           Float
  riskAmount         Float?
  price              Float?
  stopLoss           Float?
  takeProfit         Float?
  reduceOnly         Boolean             @default(false)
  isProtective       Boolean             @default(false)
  ocoGroupId         String?
  createdSequence    Int
  activeFromSequence Int
  filledSequence     Int?
  filledAt           DateTime?
  filledPrice        Float?
  cancelReason       String?
  fills              PaperFill[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([sessionId, status])
  @@index([sessionId, createdSequence])
}

model PaperFill {
  id                String              @id @default(cuid())
  sessionId         String
  session           PaperTradingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  orderId           String
  order             PaperOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sequence          Int
  timestamp         DateTime
  side              String
  price             Float
  quantity          Float
  fee               Float
  slippageCost      Float
  realizedPnl       Float
  closedQuantity    Float
  openedQuantity    Float
  netQuantityAfter  Float
  averagePriceAfter Float?
  reason            String
  createdAt         DateTime            @default(now())

  @@index([sessionId, sequence])
  @@index([orderId])
}

model PaperTrade {
  id             String              @id @default(cuid())
  sessionId      String
  session        PaperTradingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  side           String
  status         String              @default("OPEN")
  openedSequence Int
  openedAt       DateTime
  closedSequence Int?
  closedAt       DateTime?
  grossPnl       Float               @default(0)
  fees           Float               @default(0)
  plannedRisk    Float?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([sessionId, status])
  @@index([sessionId, openedSequence])
}

model PaperEquityPoint {
  sessionId String
  session   PaperTradingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sequence  Int
  timestamp DateTime
  balance   Float
  equity    Float
  drawdown  Float

  @@id([sessionId, sequence])
}
