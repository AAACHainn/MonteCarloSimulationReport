{
  "name": "monte-carlo-simulation-report",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "next dev",
    "acceptance:user-wallet": "node scripts/acceptance-user-wallet.mjs",
    "acceptance:user-growth:final": "node scripts/acceptance-user-growth-final.mjs",
    "acceptance:user-growth": "node scripts/acceptance-user-growth.mjs",
    "preview:user-growth": "node scripts/preview-user-growth.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "docs:check": "node scripts/check-docs.mjs",
    "lint": "node scripts/check-docs.mjs && eslint .",
    "test": "vitest run",
    "benchmark:drawing-projection": "node --import tsx scripts/benchmark-drawing-projection.ts",
    "benchmark:rectangle-drawings": "node --import tsx scripts/benchmark-rectangle-drawings.ts",
    "benchmark:text-drawings": "node --import tsx scripts/benchmark-text-drawings.ts",
    "benchmark:market-import-memory": "node --max-old-space-size=1024 --import tsx scripts/benchmark-market-import-memory.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:init-sqlite": "node scripts/init-sqlite.mjs",
    "db:upgrade": "node scripts/upgrade-sqlite.mjs",
    "db:runtime": "node scripts/sqlite-runtime.mjs",
    "db:prepare-sqlite": "node scripts/setup-sqlite-driver.mjs",
    "benchmark:time-aggregation": "node --import tsx scripts/benchmark-time-aggregation.ts",
    "diagnose:sqlite-commit": "node scripts/diagnose-sqlite-commit.mjs"
  },
  "dependencies": {
    "@date-fns/tz": "1.4.1",
    "@prisma/adapter-better-sqlite3": "6.19.3",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "better-sqlite3": "12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^5.6.0",
    "date-fns": "^4.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "lightweight-charts": "5.2.0",
    "lucide-react": "^0.468.0",
    "next": "^15.3.5",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.3",
    "remark-gfm": "^4.0.1",
    "sharp": "0.34.5",
    "tailwind-merge": "^2.6.0",
    "tsx": "^4.20.5",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.3.5",
    "postcss": "^8.4.49",
    "prisma": "6.19.3",
    "remark-parse": "11.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "unified": "11.0.0",
    "vitest": "^2.1.8"
  }
}
